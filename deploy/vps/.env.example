# Infra config for docker-compose.yml. Copy to `.env` and fill in.
# These are interpolated into the compose file (Postgres creds + tunnel token).

POSTGRES_USER=promptuser
# Use a strong password - this is what you'll also use over the SSH db-tunnel.
POSTGRES_PASSWORD=
POSTGRES_DB=prompt_manager

# Note: the Cloudflare Tunnel runs on the host (cloudflared systemd service),
# not in compose, so there is no tunnel token here. See README.md.
