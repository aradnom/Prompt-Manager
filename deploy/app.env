# The one place this app's name is set.
#
# Everything else derives from it: the image tag, the container name (which is
# how Caddy reaches this app over the `web` network), the compose project name,
# and the default checkout path on the box (/root/apps/$APP_NAME).
#
# Sourced by deploy.sh and the local/*.sh scripts, which export it so
# compose.yaml can interpolate it. Keep it shell-safe: no spaces, no quotes.
#
# NOTE: this is NOT the old deploy/vps/app.env, which held runtime secrets.
# Those now live in the repo-root .env (see README.md). This file is committed.
APP_NAME=prompt-manager
