# App runtime secrets for the `app` service. Copy to `app.env` and fill in.
#
# NOTE: DATABASE_URL, SESSION_DATABASE_URL, RATE_LIMIT_DATABASE_URL and
# NOTIFICATION_DATABASE_URL are intentionally NOT here - they're set in
# docker-compose.yml so the Postgres password has a single source of truth.
#
# This file is read by Docker Compose's env_file, which does NOT support inline
# comments after a value (everything after `=` is the value). Keep notes on
# their own lines.

# --- Auth secrets (all required) ---
# >= 32 random chars
SESSION_SECRET=
# exactly 32 chars
ENCRYPTION_SALT=
# >= 32 random chars
TOKEN_SECRET=
# exactly 32 chars
API_KEY_SECRET=
API_KEY_HEADER=PROMPT

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# --- LLM providers ---
LLM_ALLOWED_TARGETS=lm-studio,vertex,openai,anthropic,grok
LM_STUDIO_URL=http://localhost:11434/v1

# Vertex AI (optional). If used, the service-account JSON must exist in the
# image/container at the path below (bake it in or mount it).
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-3.1-flash-lite
VERTEX_SERVICE_ACCOUNT_JSON=./server/auth/vertex-service-account.json

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Grok / xAI (optional)
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# Email notifications (optional)
RESEND_API_KEY=
ADMIN_EMAILS=

# Cloudflare Turnstile bot protection (optional)
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=
